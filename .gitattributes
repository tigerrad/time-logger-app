# Auto detect text files and perform LF normalization
* text=auto

# Gradle files - force LF, no BOM
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.pro text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Dart
*.dart text eol=lf

# XML
*.xml text eol=lf

# Markdown
*.md text eol=lf

# JSON
*.json text eol=lf

# Binary files
*.jks binary
*.keystore binary
*.apk binary
*.png binary
*.jpg binary
*.pdf binary